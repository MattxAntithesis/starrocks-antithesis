# The StarRocks release the FE and BE images are built from. Compose reads this
# file automatically and snouty copies it into the config image, so the value is
# the same here and in Antithesis. Set it here, never in the shell: a shell
# variable overrides this file and `snouty validate` then rejects the config as
# depending on the environment.
STARROCKS_VERSION=4.1.7
